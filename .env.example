# ============================================================
# ENASH WEBSITE - LOCAL ENVIRONMENT
# Copy these same values into Azure App Service > Configuration
# > Application settings for production. Never expose these as VITE_*.
# ============================================================

PORT=8080
NODE_ENV=development
PUBLIC_SITE_URL=https://enash.co.za

# Contact destination
ENASH_CONTACT_TO=thendos@enash.co.za

# Resend
# 1) Verify enash.co.za inside Resend first.
# 2) Create an API key and paste it below.
RESEND_API_KEY=
RESEND_FROM_EMAIL="ENASH Website <website@enash.co.za>"

# Microsoft Foundry / Azure OpenAI Responses API
# Use the Azure OpenAI v1 endpoint for the deployed model.
# Example: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# Do not use a Foundry project URL ending in /api/projects/... here.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=

# Optional. Set false if you temporarily want to hide/disable AI replies.
AI_ASSISTANT_ENABLED=true
